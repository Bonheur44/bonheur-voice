# Copie ce fichier en .env.local puis remplis les valeurs.
# Tableau de bord Supabase → Project Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Clé publique (« anon key », parfois nommée « publishable key » dans les nouveaux tableaux de bord).
# Elle est visible dans le navigateur : c'est normal, la sécurité repose sur les règles RLS de la base.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Variante acceptée si ton tableau de bord n'affiche que ce nom :
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Facultatif : compte de test pour les tests de bout en bout Playwright.
# Sans ces variables, la suite e2e est ignorée automatiquement.
E2E_EMAIL=
E2E_PASSWORD=
